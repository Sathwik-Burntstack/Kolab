# Copy this file to .env and edit.

# true  = use built-in sample data (no backend needed)
# false = call your real backend
VITE_USE_MOCK=true

# Base URL of your backend API (no trailing slash).
# Examples: https://api.yourdomain.com   or   /api  (with the dev proxy below)
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: dev proxy target. When set, requests to /api are forwarded here.
# VITE_DEV_PROXY_TARGET=http://localhost:8000
